# ---------- Indispensable en production ----------
NODE_ENV=production
PUBLIC_URL=https://drdu.example          # doit être en HTTPS, sert aussi à la vérification CSRF
ANTHROPIC_API_KEY=sk-ant-...             # sans elle, le studio tourne en mode démonstration

# Abonnement (sans clé Stripe, la formule Membre serait accordée sans paiement :
# le démarrage en production échoue volontairement).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...                # abonnement mensuel 9 € TTC
STRIPE_WEBHOOK_SECRET=whsec_...          # signature de /api/billing/webhook

# ---------- Courriels transactionnels ----------
MAIL_TRANSPORT=webhook                   # "log" (défaut) ou "webhook"
MAIL_WEBHOOK_URL=https://relais.example/courriel
MAIL_FROM=D.R DU <ne-pas-repondre@drdu.example>
MAIL_REPLY_TO=accueil@drdu.example

# ---------- Infrastructure ----------
PORT=3000
HOST=0.0.0.0
DATABASE_FILE=data/drdu.sqlite           # à placer sur un volume persistant
TRUST_PROXY=true                         # uniquement derrière un proxy de confiance
APP_VERSION=                             # renvoyé par /healthz

# ---------- Mentions légales (affichées sur le site) ----------
CLINIC_PUBLISHER=Société D.R DU SAS
CLINIC_SIRET=000 000 000 00000
CLINIC_HOST=Nom et adresse de l'hébergeur certifié HDS
CLINIC_DPO=dpo@drdu.example
