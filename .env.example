# ---------- Indispensable en production ----------
NODE_ENV=production
PUBLIC_URL=https://drdu.example          # doit être en HTTPS, sert aussi à la vérification CSRF
ANTHROPIC_API_KEY=sk-ant-...             # sans elle, le studio tourne en mode démonstration

# Abonnement (sans clé Stripe, la formule Membre serait accordée sans paiement :
# le démarrage en production échoue volontairement).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...                # abonnement mensuel 9 € TTC
STRIPE_WEBHOOK_SECRET=whsec_...          # signature de /api/billing/webhook

# ---------- Courriels transactionnels ----------
MAIL_TRANSPORT=webhook                   # "log" (défaut) ou "webhook"
MAIL_WEBHOOK_URL=https://relais.example/courriel
MAIL_FROM=D.R RDV <ne-pas-repondre@drdu.example>
MAIL_REPLY_TO=accueil@drdu.example

# ---------- Plateforme ----------
MERCHANT_AUTO_APPROVE=true               # false = les fiches attendent une validation avant publication
ADMIN_EMAILS=                            # adresses des modérateurs, séparées par des virgules
                                         # (obligatoire si MERCHANT_AUTO_APPROVE=false)
PASSWORD_RESET_MINUTES=60                # durée de validité d'un lien de réinitialisation

# ---------- Outil de traduction de documents ----------
# Les documents déposés ne sont jamais écrits sur disque. Activer l'historique
# conserve les traductions : à n'ouvrir qu'avec une politique de purge.
HISTORY_ENABLED=false

# ---------- Infrastructure ----------
PORT=3000
HOST=0.0.0.0
DATABASE_FILE=data/drdu.sqlite           # à placer sur un volume persistant
TRUST_PROXY=true                         # uniquement derrière un proxy de confiance
TIMEZONE=Europe/Paris                    # fuseau des dates dans les courriels
APP_VERSION=                             # renvoyé par /healthz

# ---------- Mentions légales (affichées sur le site) ----------
SERVICE_PUBLISHER=Société D.R RDV SAS
SERVICE_SIRET=000 000 000 00000
SERVICE_HOST=Nom et adresse de l'hébergeur du site
SERVICE_DPO=dpo@drdu.example
# (aucune autre variable : la plateforme n'a pas de donneur d'ordre unique)
